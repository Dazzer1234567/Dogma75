{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config with ASIO",
      "description": "Default build configuration with ASIO support enabled",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "PA_USE_ASIO": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    }
  ]
}
